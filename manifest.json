{
  "manifest_version": 3,
  "name": "AI Voice Detection Tool",
  "version": "1.0.0",
  "description": "AI-powered voice detection for video conferencing platforms",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://teams.microsoft.com/*",
    "https://zoom.us/*",
    "https://app.webex.com/*",
    "https://meet.jit.si/*",
    "https://whereby.com/*",
    "https://discord.com/*",
    "https://web.skype.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["audio-processor.js"],
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://zoom.us/*",
        "https://app.webex.com/*",
        "https://meet.jit.si/*",
        "https://whereby.com/*",
        "https://discord.com/*",
        "https://web.skype.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://zoom.us/*",
        "https://app.webex.com/*",
        "https://meet.jit.si/*",
        "https://whereby.com/*",
        "https://discord.com/*",
        "https://web.skype.com/*"
      ],
      "js": ["content.js"]
    }
  ]
}
